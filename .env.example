# InsurUp E2E test credentials (OAuth2 client_credentials / M2M)
# Single source of truth for every package's e2e suite — each `vitest.config.e2e.ts`
# loads this file explicitly via `process.loadEnvFile()`.
#
# Copy this file to `.env` (gitignored) at the repo root and fill in the values.

INSURUP_E2E_CLIENT_ID=
INSURUP_E2E_CLIENT_SECRET=

# Optional overrides — defaults shown below
# INSURUP_E2E_AUTH_URL=https://auth.insurup.com
# INSURUP_E2E_BASE_URL=https://api.insurup.com/api/
# INSURUP_E2E_SCOPE=core-api
