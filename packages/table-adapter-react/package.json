{
  "name": "@insurup/table-adapter-react",
  "version": "0.1.0",
  "description": "React bindings for @insurup/table-adapter-core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "tanstack-table",
    "react",
    "insurup",
    "adapter",
    "typescript"
  ],
  "author": "InsurUp Engineering",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/InsurUp/ts-toolkit.git",
    "directory": "packages/table-adapter-react"
  },
  "homepage": "https://github.com/InsurUp/ts-toolkit#readme",
  "bugs": {
    "url": "https://github.com/InsurUp/ts-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "@tanstack/react-table": "^8"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.21.2",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@insurup/table-adapter-core": "workspace:*"
  }
}
