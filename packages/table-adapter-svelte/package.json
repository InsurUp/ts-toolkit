{
  "name": "@insurup/table-adapter-svelte",
  "version": "0.1.13",
  "description": "Svelte bindings for @insurup/table-adapter-core",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "build:watch": "svelte-package -i src/lib -o dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src/ test/",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "tanstack-table",
    "svelte",
    "svelte5",
    "runes",
    "insurup",
    "adapter",
    "typescript"
  ],
  "author": "InsurUp Engineering",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/InsurUp/ts-toolkit.git",
    "directory": "packages/table-adapter-svelte"
  },
  "homepage": "https://github.com/InsurUp/ts-toolkit#readme",
  "bugs": {
    "url": "https://github.com/InsurUp/ts-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": "^5",
    "@tanstack/table-core": "^8"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tanstack/table-core": "^8.21.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.3.5",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@insurup/table-adapter-core": "workspace:*"
  }
}
