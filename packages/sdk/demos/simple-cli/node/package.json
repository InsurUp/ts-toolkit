{
  "name": "@insurup/sdk-demo-cli-node",
  "version": "0.0.1",
  "description": "Interactive CLI demo for the InsurUp SDK using Node.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --import=tsx/esm src/index.ts",
    "dev": "node --import=tsx/esm --watch src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.22.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@badgateway/oauth2-client": "^3.3.1",
    "@clack/prompts": "^1.4.0",
    "@insurup/contracts": "workspace:*",
    "@insurup/sdk": "workspace:*",
    "dotenv": "^17.4.2",
    "keytar": "^7.9.0",
    "open": "^11.0.0",
    "picocolors": "^1.1.1"
  }
}
