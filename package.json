{
  "name": "@insurup/toolkit",
  "type": "module",
  "workspaces": ["packages/*", "packages/sdk/demos/cli/*", "packages/sdk/demos/simple-cli/*", "packages/sdk/demos/web/spa/*/ts", "packages/table-adapter-*/demos/spa/ts", "packages/table-adapter-core/demos/vanilla/ts"],
  "private": true,
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1"
  }
}
