{
  "name": "@insurup/toolkit",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/sdk/demos/cli/*",
    "packages/sdk/demos/simple-cli/*",
    "packages/sdk/demos/web/spa/*/ts",
    "packages/table-adapter-*/demos/spa/ts",
    "packages/table-adapter-core/demos/vanilla/ts"
  ],
  "private": true,
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13"
  }
}
